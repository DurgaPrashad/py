# Present — server environment variables.
# On Vercel: Project → Settings → Environment Variables (Production + Preview), then redeploy.
# Locally: copy this file to .env.local (git-ignored) and `npm run dev` serves api/ with these values.

# --- Payments (Razorpay Dashboard → Account & Settings → API Keys) ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Razorpay Dashboard → Webhooks → Add: URL https://present.waspid.com/api/razorpay-webhook,
# events payment.captured + order.paid, and the same secret here. Optional but recommended.
RAZORPAY_WEBHOOK_SECRET=

# --- Database (Supabase → Connect → Transaction pooler, port 6543) ---
# Serverless functions can't reach the IPv6-only direct host, so use the pooler.
# Characters such as @ in the password must be URL-encoded (@ -> %40).
DATABASE_URL=postgresql://postgres.jppzpzdsotywshwbnknn:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Built-in AI for SI (optional; users can also bring their own key) ---
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low

# --- Public Supabase settings (optional; the app has these built in) ---
# VITE_SUPABASE_URL=https://jppzpzdsotywshwbnknn.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_4CATCnaALMxUuwC4HMniVQ_aBp9kBvd
